:root {
    position: relative;
}

.shortPause {
    background-image: url("project://database/Assets/Art%20Assets/UI/Pause/ShortButton%20(Pause).png?fileID=2800000&guid=5bb6c8dacc4148b4e8e08b321a511c3f&type=3#ShortButton (Pause)");
    background-color: rgba(0, 0, 0, 0);
    min-width: 584px;
    min-height: 120px;
    font-size: 67px;
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Zyzol-Bold.otf?fileID=12800000&guid=344cd985bcb249a46a569eea7590cc62&type=3#Zyzol-Bold");
    color: rgb(255, 255, 255);
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 6px;
    -unity-text-align: middle-center;
    padding-top: 18px;
    margin-top: 14px;
}

.shortPause:hover {
    background-image: url("project://database/Assets/Art%20Assets/UI/Pause/ShortButton%20(Pause)_Hovered.png?fileID=2800000&guid=b289bb3800996ac419fda09b2198f23b&type=3#ShortButton (Pause)_Hovered");
}

.longPause {
    background-image: url("project://database/Assets/Art%20Assets/UI/Pause/LongButton%20(Pause).png?fileID=2800000&guid=50b8088fb0cc5cd4fad79850e28f590c&type=3#LongButton (Pause)");
    min-height: 120px;
    min-width: 899px;
    font-size: 58px;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/Fonts/Zyzol-Bold.otf?fileID=12800000&guid=344cd985bcb249a46a569eea7590cc62&type=3#Zyzol-Bold");
    -unity-font-style: bold;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 5px;
    padding-bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    margin-top: 14px;
}

.longPause:hover {
    background-image: url("project://database/Assets/Art%20Assets/UI/Pause/LongButton%20(Pause)_Hovered.png?fileID=2800000&guid=12efa54797fce0f448d234cba8cbdc3f&type=3#LongButton (Pause)_Hovered");
}
