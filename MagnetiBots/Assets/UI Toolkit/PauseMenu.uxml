<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="Container" style="flex-grow: 1; align-content: center; justify-content: center;">
        <ui:VisualElement name="PauseMenu" style="flex-grow: 1; align-self: center; align-content: center; min-width: 496px; justify-content: space-around; max-height: 458px; background-color: rgb(255, 255, 255); border-top-left-radius: 90px; border-top-right-radius: 90px; border-bottom-left-radius: 90px; border-bottom-right-radius: 90px; align-items: center;">
            <ui:Label text="Game Paused" parse-escape-sequences="false" style="-unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); font-size: 50px; margin-top: 0;"/>
            <ui:Button text="Menu" name="MainMenu" class="button"/>
            <ui:Button text="Settings" name="Settings" class="button"/>
            <ui:Button text="Unpause" name="Return"/>
            <ui:Button text="Quit" name="Quit" enable-rich-text="true"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
