            </ui:Button>
            <ui:Button text="" name="SettingsButton" class="mainButton">
                <ui:Image source="project://database/Assets/Art%20Assets/UI/Title%20Screen/Text/MainMenuText_02.png?fileID=2800000&amp;guid=7bad462372aa8eb488142821f37b61ba&amp;type=3#MainMenuText_02" picking-mode="Ignore" style="height: 84px; width: 323px; margin-top: 12px;"/>
            </ui:Button>
            <ui:Button text="" name="ControlsButton" class="mainButton">
