                <ui:Label text="Credits" name="SettingsLabel" class="header" style="transform-origin: center; align-content: center; align-items: center; justify-content: center; align-self: center; font-size: 71px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/Zyzol.otf?fileID=12800000&amp;guid=82db8662a4d71c74eaee21d3daa362c5&amp;type=3#Zyzol&quot;); color: rgb(110, 187, 216);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="CreditsContainers" style="flex-grow: 1; flex-direction: row; justify-content: flex-start; align-self: stretch; position: relative; align-items: stretch; align-content: auto; margin-top: 30px; margin-bottom: 145px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 0; border-bottom-left-radius: 0; border-top-right-radius: 0; border-bottom-right-radius: 0;">
            <ui:VisualElement name="OurTeam" style="flex-grow: 1; min-width: 1007px;">
                <ui:Label text="Our Team" class="text" style="font-size: 72px; -unity-text-align: middle-center; -unity-text-outline-width: 6px; -unity-font-style: bold; letter-spacing: -7px;"/>
                <ui:VisualElement name="Kaiden" class="teamMember">
                    <ui:Label text="Kaiden Davis"/>
                </ui:VisualElement>
                <ui:VisualElement name="Vincent" class="teamMember">
                    <ui:Label text="Vincent McCoy"/>
                </ui:VisualElement>
                <ui:VisualElement name="Gwen" class="teamMember">
                    <ui:Label text="Gwendolyn North"/>
                </ui:VisualElement>
                <ui:VisualElement name="Milo" class="teamMember">
                    <ui:Label text="Milo Rodgers"/>
                </ui:VisualElement>
                <ui:VisualElement name="Nick" class="teamMember">
                    <ui:Label text="Nicholas Smith"/>
                </ui:VisualElement>
                <ui:VisualElement name="Lexi" class="teamMember">
                    <ui:Label text="Lexi Vye"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="SourcedAssets" style="flex-grow: 1;">
                <ui:Label text="With Help From.." name="Label" class="text" style="font-size: 72px; -unity-text-align: middle-center; -unity-text-outline-width: 6px; -unity-font-style: bold; letter-spacing: -7px;"/>
                <ui:ListView name="SourcesList" binding-source-selection-mode="AutoAssign" data-source="project://database/Assets/Scripts/UI/SourcesList.asset?fileID=11400000&amp;guid=351a46c66b520c645bc42f09931069d6&amp;type=2#SourcesList" item-template="project://database/Assets/UI%20Toolkit/SourceTemplate.uxml?fileID=9197481963319205126&amp;guid=485d516f890dec343b03e7c8f4fcded6&amp;type=3#SourceTemplate" selection-type="None" focusable="false" virtualization-method="DynamicHeight">
                    <Bindings>
                        <ui:DataBinding property="itemsSource" data-source-path="sourceList"/>
                    </Bindings>
                </ui:ListView>
