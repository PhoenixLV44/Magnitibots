            </ui:Button>
            <ui:Button text="" name="CreditsButton" class="mainButton">
                <ui:Image source="project://database/Assets/Art%20Assets/UI/Title%20Screen/Text/MainMenuText_05.png?fileID=2800000&amp;guid=145015bf1ce810a4682d90752aef7878&amp;type=3#MainMenuText_05" scale-mode="StretchToFill" picking-mode="Ignore" style="width: 290px; height: 68px;"/>
            </ui:Button>
            <ui:Button text="" name="QuitButton" class="mainButton exit">
                <ui:Image source="project://database/Assets/Art%20Assets/UI/Title%20Screen/Text/MainMenuText_04.png?fileID=2800000&amp;guid=4dd52e00f77b65f46840a3a5538eab8e&amp;type=3#MainMenuText_04" scale-mode="StretchToFill" picking-mode="Ignore" style="width: 172px; height: 65px;"/>
