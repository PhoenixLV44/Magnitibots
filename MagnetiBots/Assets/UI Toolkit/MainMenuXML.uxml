<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/StyleSheets/MainMenuStyleSheet.uss?fileID=7433441132597879392&amp;guid=85751048f4a5be040b7dd4789b58fcf4&amp;type=3#MainMenuStyleSheet"/>
    <ui:VisualElement name="MainMenu" class="MainMenu" style="flex-direction: column; overflow: visible; display: flex; visibility: hidden; align-self: stretch; height: 1080px; width: 1912px; justify-content: center;">
        <ui:Image scale-mode="ScaleToFit" source="project://database/Assets/Art%20Assets/UI/Main%20Menu/Logo_Final2.png?fileID=2800000&amp;guid=2ba1af0bc62a6944e80fcc53d51e0c6a&amp;type=3#Logo_Final2" style="height: 336px; width: 1856px;"/>
        <ui:Button text="Start" name="StartButton" class="button" style="-unity-text-align: middle-center;"/>
        <ui:Button text="Controls" name="ControlsButton" class="button"/>
        <ui:Button text="Settings" name="SettingsButton" class="button"/>
        <ui:Button text="Quit" name="QuitButton" class="button"/>
    </ui:VisualElement>
    <ui:VisualElement name="SettingsMenu" class="SettingsMenu" style="flex-grow: 1; justify-content: flex-start; transform-origin: left top; visibility: visible; align-items: center; align-self: stretch; align-content: auto; position: relative;">
        <ui:VisualElement name="UpperBorder" style="align-content: stretch; flex-grow: 1; flex-direction: row-reverse; justify-content: space-around; align-items: stretch; align-self: stretch;">
            <ui:Label text="Settings" name="SettingsLabel" class="header" style="transform-origin: center; align-content: center; align-items: center; justify-content: center; align-self: center;"/>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsContainers" style="flex-grow: 0; flex-direction: column; justify-content: flex-start; align-self: stretch; position: relative; align-items: stretch; align-content: auto;">
            <ui:VisualElement name="MasterVolumeBox" class="SliderBin">
                <ui:Label text="Master Volume"/>
                <ui:Slider label="" value="100" high-value="1" name="MasterVolumeSlider" fill="true" show-input-field="false" class="text settingSlider"/>
            </ui:VisualElement>
            <ui:VisualElement name="BGMVolumeBox" class="SliderBin">
                <ui:Label text="Music"/>
                <ui:Slider label="" value="100" high-value="1" name="BGMVolumeSlider" fill="true" class="settingSlider"/>
            </ui:VisualElement>
            <ui:VisualElement name="SFXVolumeBox" class="SliderBin">
                <ui:Label text="Sound Effects" name=""/>
                <ui:Slider label="" value="100" high-value="1" name="SFXVolumeSlider" fill="true" class="settingSlider"/>
            </ui:VisualElement>
            <ui:VisualElement name="Cursor" class="SliderBin">
                <ui:Label text="Cursor Sensitivity" name="" emoji-fallback-support="true" double-click-selects-word="true"/>
                <ui:Slider label="" value="100" high-value="100" name="MouseSensitivitySlider" fill="true" class="settingSlider" style="flex-direction: row; align-items: auto;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="Close" name="ReturnButton" emoji-fallback-support="false" enable-rich-text="true" class="button" style="-unity-text-align: middle-center; white-space: nowrap; background-image: url(&quot;project://database/Assets/Art%20Assets/UI/Main%20Menu/Close%20Button.png?fileID=2800000&amp;guid=84df5b9adcee4e241b98db1a6de9fbe4&amp;type=3#Close Button&quot;); background-color: rgba(255, 255, 255, 0); -unity-background-image-tint-color: rgb(255, 255, 255); background-size: 100% 100%; -unity-background-scale-mode: scale-to-fit; width: 429px; height: 115px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/Zyzol.otf?fileID=12800000&amp;guid=82db8662a4d71c74eaee21d3daa362c5&amp;type=3#Zyzol&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 5px; -unity-text-outline-color: rgb(0, 0, 0); -unity-text-generator: standard; -unity-text-auto-size: none; visibility: visible; font-size: 71px; letter-spacing: 0; align-self: flex-start; align-content: flex-start; justify-content: flex-end; align-items: flex-start; position: absolute; bottom: 0;"/>
    </ui:VisualElement>
    <ui:VisualElement name="ControlsMenu" class="ControlsMenu" style="flex-grow: 1; justify-content: space-between; transform-origin: left top; visibility: hidden; display: flex; align-self: stretch; width: 1908px; height: 1066px;">
        <ui:Label text="Settings" name="SettingsLabel" class="header" style="transform-origin: center;"/>
        <ui:Label text="WASD to Move&#10;Space to Jump&#10;Right Click + Mouse to rotate the Camera&#10;Hold space to Propeller (when unlocked)&#10;Hold Left Mouse to charge ability&#10;Move Mouse to move Lasso&apos;d objects&#10;E to pull Lasso&apos;d Levers&#10;R to Respawn" name="ControlList" style="font-size: 51px;"/>
        <ui:Button text="Return" name="ControlsReturnButton" class="button"/>
    </ui:VisualElement>
</ui:UXML>
