    <ui:VisualElement name="SettingsMenu" class="SettingsMenu" style="flex-grow: 1; justify-content: flex-start; transform-origin: left top; align-items: center; align-self: center; align-content: auto; position: absolute; top: 0; width: 1920px; height: 1080px; visibility: hidden;">
        <ui:VisualElement style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; -unity-material: url(&quot;project://database/Assets/UI%20Toolkit/ScrollingTexture/UIScrollingMaterial.mat?fileID=2100000&amp;guid=d07ce5a78be671742999f33dc54c1403&amp;type=2#UIScrollingMaterial&quot;); background-color: rgb(255, 255, 255);"/>
        <ui:VisualElement name="UpperBorder" style="align-content: stretch; flex-grow: 1; flex-direction: row-reverse; justify-content: space-around; align-items: stretch; align-self: stretch; max-height: 196px; background-image: url(&quot;project://database/Assets/Art%20Assets/UI/Settings/Upper%20Border.png?fileID=2800000&amp;guid=0210c0b24bb5f794cb539551372ac845&amp;type=3#Upper Border&quot;);">
            <ui:VisualElement name="VisualElement" style="flex-grow: 1; align-items: center; max-height: 109px; max-width: 1045px; margin-top: 26px; flex-direction: row; background-image: url(&quot;project://database/Assets/Art%20Assets/UI/Settings/Menu%20Title%201.png?fileID=2800000&amp;guid=b2f813ba251c8454dbe8ad23bae158bb&amp;type=3#Menu Title 1&quot;); -unity-text-align: middle-center; justify-content: center;">
                <ui:Label text="Settings" name="SettingsLabel" class="header" style="transform-origin: center; align-content: center; align-items: center; justify-content: center; align-self: center; font-size: 71px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/Zyzol.otf?fileID=12800000&amp;guid=82db8662a4d71c74eaee21d3daa362c5&amp;type=3#Zyzol&quot;); color: rgb(110, 187, 216);"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="SettingsContainers" style="flex-grow: 1; flex-direction: column; justify-content: flex-start; align-self: stretch; position: relative; align-items: stretch; align-content: auto; margin-top: 112px; margin-bottom: 257px;">
            <ui:VisualElement name="MasterVolumeBox" class="SliderBin">
                <ui:Label text="Master Volume"/>
                <ui:Slider label="" value="100" high-value="1" name="MasterVolumeSlider" fill="true" show-input-field="false" class="settingSlider"/>
            </ui:VisualElement>
            <ui:VisualElement name="BGMVolumeBox" class="SliderBin">
                <ui:Label text="Music"/>
                <ui:Slider label="" value="100" high-value="1" name="BGMVolumeSlider" fill="true" class="settingSlider"/>
            </ui:VisualElement>
            <ui:VisualElement name="SFXVolumeBox" class="SliderBin">
                <ui:Label text="Sound Effects" name=""/>
                <ui:Slider label="" value="100" high-value="1" name="SFXVolumeSlider" fill="true" class="settingSlider"/>
            </ui:VisualElement>
            <ui:VisualElement name="Cursor" class="SliderBin">
                <ui:Label text="Cursor Sensitivity" name="" emoji-fallback-support="true" double-click-selects-word="true"/>
                <ui:Slider label="" value="100" high-value="100" name="MouseSensitivitySlider" fill="true" class="settingSlider" style="flex-direction: row; align-items: auto;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Art%20Assets/UI/Settings/Lower%20Border.png?fileID=2800000&amp;guid=761b7bf0e469841429019df4244ba07b&amp;type=3#Lower Border&quot;); width: 1920px; position: absolute; bottom: 0; height: 83px;">
            <ui:Button text="" name="ReturnButton" emoji-fallback-support="false" enable-rich-text="true" class="button closeButton" style="-unity-text-align: middle-center; white-space: nowrap; background-color: rgba(255, 255, 255, 0); -unity-background-image-tint-color: rgb(255, 255, 255); background-size: 100% 100%; -unity-background-scale-mode: scale-to-fit; width: 429px; height: 115px; -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/Fonts/Zyzol.otf?fileID=12800000&amp;guid=82db8662a4d71c74eaee21d3daa362c5&amp;type=3#Zyzol&quot;); color: rgb(255, 255, 255); -unity-text-outline-width: 5px; -unity-text-outline-color: rgb(0, 0, 0); -unity-text-generator: standard; -unity-text-auto-size: none; font-size: 71px; letter-spacing: 0; align-self: flex-start; align-content: flex-start; justify-content: center; align-items: center; position: absolute; bottom: 0; margin-left: 0; margin-right: 0; top: auto; left: 0; right: auto;">
                <ui:Image source="project://database/Assets/Art%20Assets/UI/Close.png?fileID=2800000&amp;guid=5ac41b61e37b2174d90f1463d111eadf&amp;type=3#Close" scale-mode="StretchToFill" picking-mode="Ignore" style="min-width: 172px; min-height: 55px; width: 194px; margin-bottom: 12px;"/>
            </ui:Button>
            <ui:Image source="project://database/Assets/Art%20Assets/UI/Settings/Mrble.png?fileID=2800000&amp;guid=447c319236f244445a18e5c57355201e&amp;type=3#Mrble" scale-mode="StretchToFill" style="position: absolute; right: 29px; bottom: 20px; flex-grow: 1; width: 147px; aspect-ratio: 1.25;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:Instance template="ControlsMenu" name="ControlsMenu" style="visibility: hidden;"/>
    <ui:VisualElement name="CreditsMenu" style="flex-grow: 1; justify-content: flex-start; transform-origin: left top; align-items: center; align-self: center; align-content: auto; position: absolute; top: 0; width: 1920px; height: 1080px; visibility: hidden;">
