<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/StyleSheets/MainMenuStyleSheet.uss?fileID=7433441132597879392&amp;guid=85751048f4a5be040b7dd4789b58fcf4&amp;type=3#MainMenuStyleSheet"/>
    <ui:VisualElement name="MainMenu" class="MainMenu" style="flex-grow: 1; flex-direction: column; overflow: visible; display: flex; visibility: visible;">
        <ui:Label text="Magnetibots" class="header" style="height: auto;"/>
        <ui:Button text="Start" name="StartButton" class="button"/>
        <ui:Button text="Controls" name="ControlsButton" class="button"/>
        <ui:Button text="Settings" name="SettingsButton" class="button"/>
        <ui:Button text="Quit" name="QuitButton" class="button"/>
    </ui:VisualElement>
    <ui:VisualElement name="SettingsMenu" class="SettingsMenu" style="flex-grow: 1; justify-content: flex-start; transform-origin: left top; width: auto; visibility: hidden; align-items: center; align-self: auto; align-content: auto; position: relative;">
        <ui:Label text="Settings" name="SettingsLabel" class="header" style="transform-origin: center;"/>
        <ui:VisualElement name="SettingsContainers" style="flex-grow: 1; flex-direction: row; justify-content: center; align-self: stretch;">
            <ui:VisualElement name="Volumes" style="width: 960px;">
                <ui:Label text="Volume" style="-unity-text-align: upper-center; font-size: 50px;"/>
                <ui:Slider label="Master" value="1" high-value="1" name="MasterVolumeSlider" fill="true" low-value="0" class="settingSlider"/>
                <ui:Slider label="Music" value="1" high-value="1" name="BGMVolumeSlider" fill="true" low-value="0" class="settingSlider"/>
                <ui:Slider label="Effects" value="1" high-value="1" name="SFXVolumeSlider" fill="true" low-value="0" class="settingSlider"/>
                <ui:Slider label="Menus" value="1" high-value="1" name="UIVolumeSlider" fill="true" low-value="0" class="settingSlider"/>
            </ui:VisualElement>
            <ui:VisualElement name="Cursor" style="flex-grow: 1; flex-direction: column;">
                <ui:Label text="Cursor" name="Label" style="font-size: 50px; -unity-text-align: upper-center;"/>
                <ui:Slider label="Sensitivity" value="100" high-value="100" name="MouseSensitivitySlider" fill="true" class="settingSlider" style="flex-direction: row; align-items: auto;"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="Return" name="ReturnButton" class="button"/>
    </ui:VisualElement>
    <ui:VisualElement name="ControlsMenu" class="ControlsMenu" style="flex-grow: 1; justify-content: space-between; transform-origin: left top; width: 1780px; visibility: hidden; display: flex;">
        <ui:Label text="Settings" name="SettingsLabel" class="header" style="transform-origin: center;"/>
        <ui:Label text="WASD to Move&#10;Space to Jump&#10;Right Click + Mouse to rotate the Camera&#10;Hold space to Propeller (when unlocked)&#10;Hold Left Mouse to charge ability&#10;Move Mouse to move Lasso&apos;d objects&#10;E to pull Lasso&apos;d Levers&#10;R to Respawn" name="ControlList" style="font-size: 51px;"/>
        <ui:Button text="Return" name="ControlsReturnButton" class="button"/>
    </ui:VisualElement>
</ui:UXML>
